# Copy to config.env (same folder) to change the defaults. Every line is optional.

# Command the build check runs after each phase.
# Default: "npm run build" when package.json has a build script, otherwise no check.
# Set to an empty string to turn the check off.
CHECK_CMD="npm run build"

# How many times Claude may try to fix a failing check before it must stop.
MAX_FIX=2

# 1 = commit after each phase (message from prompts/<phase>.commit), 0 = don't commit.
GIT_COMMIT=1
